REACT_APP_API_URL=http://localhost:7372


# ─── RAZORPAY KEY ────────────────────────────────────────────────────────
# Primary source for the checkout key. IMPORTANT: the backend creates the
# order with ITS OWN key (RAZORPAY_KEY_ID in the backend .env), so switch
# BOTH together:
#
#   LIVE mode   (production backend): key below = rzp_live_...
#   TEST mode   (localhost backend)  : key below = rzp_test_...
#
# If the .env key mismatches the backend key, checkout falls back to the
# backend key and logs a loud console error (utils/razorpay.js).
REACT_APP_RAZORPAY_KEY_ID=rzp_live_T0fVFI0ooTy7Gz

# TEST key — enable this when developing against the local backend
# (REACT_APP_API_URL=http://localhost:7372):
# REACT_APP_RAZORPAY_KEY_ID=rzp_test_SgtIWkAwfIWQZP
WDS_SOCKET_PORT=0

GENERATE_SOURCEMAP=false